# Copie este arquivo para .env e preencha com os valores da SUA máquina.
# Nunca faça commit do arquivo .env.

# Porta da API
PORT=3000
NODE_ENV=development

# Banco PostgreSQL de desenvolvimento
DATABASE_URL=postgres://usuario:senha@localhost:5432/gestao_indicadores

# Banco PostgreSQL separado, usado só pelos testes (é apagado e recriado)
DATABASE_URL_TEST=postgres://usuario:senha@localhost:5432/gestao_indicadores_test

# Sessão: gere um valor aleatório longo, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio
# Minutos de inatividade até a sessão expirar (RNF12)
SESSION_TIMEOUT_MINUTES=30

# Validade do token de recuperação de senha, em minutos
RESET_TOKEN_EXPIRES_MINUTES=60
